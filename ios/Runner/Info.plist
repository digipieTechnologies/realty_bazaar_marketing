	<string>Brokerflow-Ads requires microphone access to record videos with audio.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Brokerflow-Ads requires access to your location to share your current position with users in chat.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Brokerflow-Ads requires access to your location to share your current position with users in chat.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
